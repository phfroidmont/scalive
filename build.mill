//| - com.raquo::domtypes:19.0.2
//| - com.goyeau::mill-scalafix::0.6.2
//| - ch.epfl.scala:scalafix-interfaces:0.14.9
//| - com.lihaoyi::mill-contrib-jmh:1.3.0
//| mill-version: 1.3.0
//| mill-jvm-version: system
//| mill-jvm-opts: ["-Xmx4g", "-XX:G1PeriodicGCInterval=15000", "-XX:MinHeapFreeRatio=10", "-XX:MaxHeapFreeRatio=30"]

package build

import mill.*, scalalib.*, publish.*
import mill.api.BuildCtx
import mill.scalalib.scalafmt.ScalafmtModule
import mill.contrib.jmh.JmhModule
import mill.util.Jvm
import com.goyeau.mill.scalafix.ScalafixModule

object Versions:
  val zioJson = "1.1.0"
  val zioHttp = "3.11.6"
  val zioTest = "2.1.26"

trait ScalaCommon extends ScalaModule with ScalafmtModule with ScalafixModule:
  def scalaVersion  = "3.10.0"
  def scalacOptions = Seq(
    "-Wunused:all",
    "-preview",
    "-feature",
    "-language:implicitConversions",
    """-Wconf:msg=.*unused explicit parameter.*&src=.*[/\\](LiveView|LiveComponent)\.scala:silent""",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-deprecation"
  )

  // Heap cap of the JVMs started by `run`, `runBackground`, JMH and the documentation tools.
  def forkArgs = Seq("-Xmx1g")

  trait ScaliveTests extends ScalaTests with TestModule.ZioTest:
    def zioTestVersion = Versions.zioTest
    def forkArgs       = Seq("-Xmx1g")

trait PublishCommon extends PublishModule:
  def artifactDescription: String

  def publishVersion = Task.Input {
    val revision = Task.env.getOrElse(
      "SCALIVE_REVISION",
      os.proc("git", "rev-parse", "HEAD").call(cwd = BuildCtx.workspaceRoot).out.text().trim
    )
    s"0.0.1-${revision.take(12)}-SNAPSHOT"
  }
  def pomSettings    = PomSettings(
    description = artifactDescription,
    organization = "dev.scalive",
    url = "https://github.com/phfroidmont/scalive",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("phfroidmont", "scalive"),
    developers =
      Seq(Developer("phfroidmont", "Paul-Henri Froidmont", "https://github.com/phfroidmont"))
  )

trait ScaliveModule extends ScalaCommon:
  object test extends ScaliveTests

trait PublishedScaliveModule extends ScaliveModule with PublishCommon

trait PublishedScaliveBundle extends PublishedScaliveModule:
  protected def bundledModules: Seq[ScaliveModule]

  private def bundledCompilations = Task.traverse(bundledModules)(_.compile)
  private def bundledResources = Task.traverse(bundledModules)(_.resources)
  private def bundledCompileResources = Task.traverse(bundledModules)(_.compileResources)
  private def bundledSources = Task.traverse(bundledModules) { module =>
    Task.Anon {
      module.allSources() ++ module.resources() ++ module.compileResources()
    }
  }
  private def bundledDocSources  = Task.traverse(bundledModules)(_.docSources)
  private def bundledMvnDeps     = Task.traverse(bundledModules)(_.mvnDeps)
  private def bundledCompileDeps = Task.traverse(bundledModules)(_.compileMvnDeps)
  private def bundledRunDeps     = Task.traverse(bundledModules)(_.runMvnDeps)
  private def bundledBomDeps     = Task.traverse(bundledModules)(_.bomMvnDeps)
  private def bundledDepMgmt     = Task.traverse(bundledModules)(_.depManagement)

  def bundledClasses = Task {
    bundledCompilations().map(_.classes)
  }

  override def unmanagedClasspath = Task {
    super.unmanagedClasspath() ++ bundledClasses()
  }

  override def resources = Task {
    super.resources() ++ bundledResources().flatten
  }

  override def compileResources = Task {
    super.compileResources() ++ bundledCompileResources().flatten
  }

  override def mvnDeps = Task {
    (super.mvnDeps() ++ bundledMvnDeps().flatten).distinct
  }

  override def compileMvnDeps = Task {
    (super.compileMvnDeps() ++ bundledCompileDeps().flatten).distinct
  }

  override def runMvnDeps = Task {
    (super.runMvnDeps() ++ bundledRunDeps().flatten).distinct
  }

  override def bomMvnDeps = Task {
    (super.bomMvnDeps() ++ bundledBomDeps().flatten).distinct
  }

  override def depManagement = Task {
    (super.depManagement() ++ bundledDepMgmt().flatten).distinct
  }

  override def docSources = Task {
    super.docSources() ++ bundledDocSources().flatten
  }

  override def sourceJar = Task {
    val inputs =
      super.allSources() ++
        super.resources() ++
        super.compileResources() ++
        bundledSources().flatten
    PathRef(
      Jvm.createJar(
        Task.dest / "out.jar",
        inputs.map(_.path).filter(os.exists),
        manifest()
      )
    )
  }

object scalive extends PublishedScaliveBundle:
  def artifactDescription   =
    "Scala 3 server-driven web applications compatible with Phoenix LiveView"

  private val liveViewClientResourceDigests = Seq(
    "META-INF/scalive/live-view-client/PROVENANCE.md" ->
      "3b9fc4bae95791ea7781ce7ad9dad7c9daed7a88ab5381e75db00790874ad336",
    "META-INF/scalive/live-view-client/phoenix-1.8.15-live-view-1.2.12/phoenix.min.js" ->
      "02470e33af505595906535b87432092c19e1053a0029c7257986837781891e41",
    "META-INF/scalive/live-view-client/phoenix-1.8.15-live-view-1.2.12/phoenix_live_view.min.js" ->
      "b3644c575949ce39f4cebf2d53f01eee659ae2ac4111075f4a7ece1002fecadc",
    "META-INF/licenses/scalive/live-view-client/phoenix-1.8.15-LICENSE.md" ->
      "41a686069f0199ff369d7e5277d5267385cc54d9199f1efc960bacbe2e799255",
    "META-INF/licenses/scalive/live-view-client/phoenix-live-view-1.2.12-LICENSE.md" ->
      "5a76ffa3373ac1fbc8c8645967b980896154c26113c827d3c01c4b0158c057c6"
  )

  private def sha256(bytes: Array[Byte]): String =
    java.security.MessageDigest
      .getInstance("SHA-256")
      .digest(bytes)
      .map(byte => f"${byte & 0xff}%02x")
      .mkString

  private def archiveSha256(archive: java.util.zip.ZipFile, resource: String): String =
    val input = archive.getInputStream(archive.getEntry(resource))
    try sha256(input.readAllBytes())
    finally input.close()

  def checkLiveViewClientResources = Task {
    val archives = Seq("binary JAR" -> jar().path, "source JAR" -> sourceJar().path)

    archives.foreach { case (label, path) =>
      val archive = new java.util.zip.ZipFile(path.toIO)
      try
        val missing = liveViewClientResourceDigests.collect {
          case (resource, _) if archive.getEntry(resource) == null => resource
        }
        if missing.nonEmpty then
          throw new IllegalStateException(
            s"Scalive $label is missing LiveView client resources: ${missing.mkString(", ")}"
          )
        val mismatched = liveViewClientResourceDigests.collect {
          case (resource, expected) if archiveSha256(archive, resource) != expected => resource
        }
        if mismatched.nonEmpty then
          throw new IllegalStateException(
            s"Scalive $label contains invalid LiveView client resources: ${mismatched.mkString(", ")}"
          )
      finally archive.close()
    }
  }

  protected def bundledModules = Seq(
    api,
    render,
    runtime.contracts,
    runtime.resources,
    runtime.kernel,
    runtime.connection,
    protocol.phoenix,
    transport.`zio-http`
  )

  object api extends ScaliveModule:
    def mvnDeps = Seq(
      mvn"dev.zio::zio-json:${Versions.zioJson}",
      mvn"dev.zio::zio-http:${Versions.zioHttp}"
    )

    def generatedSources = Task {
      new DomDefsGenerator((Task.dest / "src/scalive").toString).generate()
      super.generatedSources() ++ Seq(PathRef(Task.dest / "src"))
    }

  object render extends ScaliveModule:
    def moduleDeps = Seq(api)

  object runtime extends Module:
    object contracts extends ScaliveModule:
      def moduleDeps = Seq(api)

    object resources extends ScaliveModule:
      def moduleDeps = Seq(api, contracts)

    object kernel extends ScaliveModule:
      def moduleDeps = Seq(api, render, contracts, runtime.resources)

    object connection extends ScaliveModule:
      def moduleDeps = Seq(contracts, kernel, runtime.resources)

  object protocol extends Module:
    object phoenix extends ScaliveModule:
      def moduleDeps = Seq(render)

  object transport extends Module:
    object `zio-http` extends ScaliveModule:
      def moduleDeps = Seq(api, runtime.connection, protocol.phoenix)

      def mvnDeps = Seq(mvn"dev.zio::zio-http:${Versions.zioHttp}")

      private val liveViewClientResourcesVariable = "SCALIVE_LIVE_VIEW_CLIENT_RESOURCES"

      // Mill BSP assumes input PathRefs are workspace-relative, so keep the Nix path scalar.
      private def liveViewClientResourceRoot = Task.Input {
        Task.env.get(liveViewClientResourcesVariable)
      }

      private def liveViewClientResources = Task {
        val root = liveViewClientResourceRoot()
          .map(os.Path(_))
          .getOrElse(
            throw new IllegalStateException(
              s"$liveViewClientResourcesVariable is not set. Enter via nix develop."
            )
          )
        val missing = liveViewClientResourceDigests.collect {
          case (resource, _) if !os.isFile(root / os.RelPath(resource)) => resource
        }
        if missing.nonEmpty then
          throw new IllegalStateException(
            s"$liveViewClientResourcesVariable does not contain the required resources: ${missing.mkString(", ")}"
          )
        val mismatched = liveViewClientResourceDigests.collect {
          case (resource, expected)
              if sha256(os.read.bytes(root / os.RelPath(resource))) != expected => resource
        }
        if mismatched.nonEmpty then
          throw new IllegalStateException(
            s"$liveViewClientResourcesVariable contains invalid resources: ${mismatched.mkString(", ")}"
          )
        liveViewClientResourceDigests.foreach { case (resource, _) =>
          val relative = os.RelPath(resource)
          os.copy(root / relative, Task.dest / relative, createFolders = true)
        }
        PathRef(Task.dest)
      }

      override def resources = Task {
        super.resources() :+ liveViewClientResources()
      }

  object testing extends PublishedScaliveModule:
    def artifactDescription   =
      "Disconnected and connected behavioral testing for Scalive applications"
    def moduleDeps = Seq(scalive)
    def mvnDeps    = Seq(mvn"org.jsoup:jsoup:1.23.2")

object benchmarks extends ScalaCommon with JmhModule:
  def moduleDeps    = Seq(scalive)
  def jmhCoreVersion = "1.37"

object e2eApp extends ScalaCommon with NpmAssets:
  def moduleDeps = Seq(scalive)
  def mvnDeps    = Seq(mvn"dev.zio::zio-logging:2.5.3")
  override def forkArgs = Seq("-Xmx512m")

  def resources = Task {
    super.resources() :+ bundle()
  }

object rootSliceApp extends ScalaCommon:
  def moduleDeps = Seq(scalive)
  override def forkArgs = Seq("-Xmx512m")
