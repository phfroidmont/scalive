{
  "name": "scalive-documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:brand && npm run build:bundle && npm run build:manifest",
    "build:brand": "node assets/build-brand-assets.mjs",
    "build:bundle": "node assets/build-bundle.mjs",
    "build:manifest": "node assets/write-assets-manifest.mjs",
    "build:css": "tailwindcss -i assets/css/app.css -o build/app.css --minify",
    "test": "node --test assets/js/browser-interop.test.js assets/js/diagram-theme.test.js assets/js/search.test.js assets/js/xray/phoenix-live-view-1.2.12.test.js",
    "test:xray": "playwright test --config playwright.xray.config.js"
  },
  "dependencies": {
    "phoenix": "1.8.15",
    "phoenix_live_view": "1.2.12"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  }
}
