package build

import com.raquo.domtypes.codegen.*
import com.raquo.domtypes.codegen.DefType.LazyVal
import com.raquo.domtypes.defs.styles.StyleTraitDefs
import com.raquo.domtypes.codegen.generators.*
import com.raquo.domtypes.common.*
import com.raquo.domtypes.defs.attrs.AriaAttrDefs
import com.raquo.domtypes.defs.reflectedAttrs.ReflectedHtmlAttrDefs

class DomDefsGenerator(baseOutputDirectoryPath: String):

  private final case class NamespacedAttrDef(
    scalaName: String,
    attrSuffix: String,
    valueType: String)

  private val additionalAriaCommentLines = Map(
    "aria-details" -> List(
      "Identifies the element (or elements) that provide additional information related to the object."
    ),
    "aria-errormessage" -> List(
      "Identifies the element (or elements) that provide an error message for the object."
    ),
    "aria-keyshortcuts" -> List(
      "Indicates keyboard shortcuts implemented by the author to activate or give focus to an element."
    ),
    "aria-modal" -> List(
      "Indicates whether an element is modal when displayed."
    ),
    "aria-placeholder" -> List(
      "Defines a short hint intended to help the user enter data when a control has no value."
    ),
    "aria-roledescription" -> List(
      "Defines a human-readable, author-localized description for the role of an element."
    )
  )

  private val ariaAttrsByDomName = AriaAttrDefs.defs.map(d => d.domName -> d).toMap

  private def scaladocLines(indent: String, commentLines: List[String]): List[String] =
    commentLines match
      case Nil          => Nil
      case line :: Nil  => List(s"$indent/** $line */")
      case multipleLines =>
        List(s"$indent/**") ++
          multipleLines.map(line => s"$indent  * $line") ++
          List(s"$indent  */")

  private def commentSections(sections: List[List[String]]): List[String] =
    sections.filter(_.nonEmpty) match
      case Nil          => Nil
      case head :: tail => head ++ tail.flatMap(section => "" +: section)

  private def mdnDocLine(url: String): String =
    val caption = url.substring(url.lastIndexOf("/") + 1)
    s"[[$url $caption @ MDN]]"

  private def namespacedAttrCommentLines(
    namespaceName: String,
    defs: List[NamespacedAttrDef],
    attr: NamespacedAttrDef
  ): List[String] =
    val domName = s"$namespaceName-${attr.attrSuffix}"

    val sourceDef = namespaceName match
      case "aria" => ariaAttrsByDomName.get(domName)
      // Scalive emits hyphenated HTML attributes, not the XML attributes described by SVG XLink.
      case _ => None

    val sourceComments = sourceDef
      .map(_.commentLines)
      .filter(_.nonEmpty)
      .getOrElse(additionalAriaCommentLines.getOrElse(domName, Nil))

    val generatedAriaNames = defs.map(d => s"aria-${d.attrSuffix}" -> d.scalaName).toMap
    val linkedComments =
      if namespaceName == "aria" then
        AriaAttrDefs.defs.foldLeft(sourceComments) { (lines, ariaDef) =>
          val replacement = generatedAriaNames
            .get(ariaDef.domName)
            .map(name => s"[[$name]]")
            .getOrElse(s"`${ariaDef.domName}`")
          lines.map(_.replace(s"[[${ariaDef.scalaName}]]", replacement))
        }
      else sourceComments

    val docUrls = sourceDef
      .map(_.docUrls)
      .filter(_.nonEmpty)
      .getOrElse(
        if namespaceName == "aria" then
          List(s"https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Attributes/$domName")
        else Nil
      )

    commentSections(
      List(
        List(s"Defines the `$domName` HTML attribute."),
        linkedComments,
        docUrls.map(mdnDocLine)
      )
    )

  private def namespaceCommentLines(namespaceName: String): List[String] =
    namespaceName match
      case "aria" =>
        List(
          "ARIA attribute definitions.",
          "",
          "For example, `aria.label := \"Dialog\"` emits the `aria-label` HTML attribute."
        )
      case "xlink" =>
        List(
          "Hyphenated `xlink-*` HTML attribute definitions.",
          "",
          "For example, `xlink.href := \"#target\"` emits `xlink-href`, not the XML `xlink:href` form."
        )
      case _ => Nil

  private def scaliveAttrComments(attr: AttrDef): AttrDef =
    val linkedComments = attr.commentLines.map(
      _.replace("[[FormTags.dataList]]", "`dataList`")
        .replace("[[FormTags.form]]", "the `<form>` element")
        .replace("[[name]]", "[[nameAttr]]")
        .replace("See [[Props.checked]]", "Scalive emits the reflected `checked` HTML attribute.")
        .replace("See [[Props.selected]]", "Scalive emits the reflected `selected` HTML attribute.")
        .replace("See also [[Props.value]]", "Scalive emits the reflected `value` HTML attribute.")
    )

    attr.domName match
      case "maxlength" =>
        attr.copy(commentLines = List(
          "Specifies the maximum number of characters accepted by a compatible form control.",
          "Browsers enforce the limit during editing and expose constraint-validation state when applicable."
        ))
      case "scoped" =>
        attr.copy(commentLines = List(
          "Defines the obsolete `scoped` attribute for a `<style>` element.",
          "Current browsers do not implement scoped-style behavior; use ordinary CSS scoping instead."
        ))
      case _ => attr.copy(commentLines = linkedComments)

  private def scaliveTagComments(tag: TagDef): TagDef =
    tag.domName match
      case "slot" => tag.copy(isVoid = false)
      case "del" => tag.copy(commentLines = List("Represents content removed from the document."))
      case "keygen" =>
        tag.copy(
          commentLines = List(
            "Defines the obsolete `<keygen>` element.",
            "Current browsers do not support this element; it remains available only for source compatibility."
          ),
          docUrls = Nil
        )
      case _ => tag

  private def generateNamespacedHtmlKeysTrait(
    traitName: String,
    namespaces: List[(String, List[NamespacedAttrDef])]
  ): String =
    val headerLines = List(
      "package scalive.defs.complex",
      "",
      "import scalive.HtmlAttr",
      "import scalive.codecs._",
      "",
      "// #NOTE: GENERATED CODE",
      "//  - This file is generated at compile time from the data in Scala DOM Types",
      "//  - See `DomDefsGenerator.mill` for code generation params",
      "//  - Contribute to https://github.com/raquo/scala-dom-types to add missing tags / attrs / props / etc.",
      ""
    )

    val bodyLines = namespaces.flatMap { (namespaceName, defs) =>
      val nsHeader = scaladocLines("  ", namespaceCommentLines(namespaceName)) ++ List(
        s"  object ${namespaceName}:",
        s"    private inline def attrName(suffix: String) = \"${namespaceName}-\" + suffix",
        ""
      )

      val valueHelpers = defs
        .map(_.valueType)
        .distinct
        .flatMap {
          case "Boolean" =>
            List(
              "    private inline def boolAttr(suffix: String): HtmlAttr[Boolean] = new HtmlAttr(attrName(suffix), BooleanAsTrueFalseStringEncoder)",
              ""
            )
          case "String" =>
            List(
              "    private inline def stringAttr(suffix: String): HtmlAttr[String] = new HtmlAttr(attrName(suffix), StringAsIsEncoder)",
              ""
            )
          case "Int" =>
            List(
              "    private inline def intAttr(suffix: String): HtmlAttr[Int] = new HtmlAttr(attrName(suffix), IntAsStringEncoder)",
              ""
            )
          case "Double" =>
            List(
              "    private inline def doubleAttr(suffix: String): HtmlAttr[Double] = new HtmlAttr(attrName(suffix), DoubleAsStringEncoder)",
              ""
            )
          case unsupported =>
            throw new IllegalArgumentException(s"Unsupported value type for namespaced attr generation: $unsupported")
        }

      val attrDefs = defs.flatMap { d =>
        val helper = d.valueType match
          case "Boolean" => "boolAttr"
          case "String"  => "stringAttr"
          case "Int"     => "intAttr"
          case "Double"  => "doubleAttr"
          case _           => throw new IllegalArgumentException(s"Unsupported value type: ${d.valueType}")

        scaladocLines("    ", namespacedAttrCommentLines(namespaceName, defs, d)) ++ List(
          s"    lazy val ${d.scalaName}: HtmlAttr[${d.valueType}] = $helper(\"${d.attrSuffix}\")",
          ""
        )
      }

      nsHeader ++ valueHelpers ++ attrDefs ++ List("", "")
    }

    val traitCommentLines = List(
      "Generated composite HTML attribute definitions grouped under [[aria]] and [[xlink]]."
    )

    (headerLines ++ scaladocLines("", traitCommentLines) ++ List(s"trait $traitName:", "") ++ bodyLines)
      .mkString("\n")

  private object generator
      extends CanonicalGenerator(
        baseOutputDirectoryPath = baseOutputDirectoryPath,
        basePackagePath = "scalive",
        standardTraitCommentLines = List(
          "#NOTE: GENERATED CODE",
          s" - This file is generated at compile time from the data in Scala DOM Types",
          " - See `DomDefsGenerator.mill` for code generation params",
          " - Contribute to https://github.com/raquo/scala-dom-types to add missing tags / attrs / props / etc."
        ),
        format = CodeFormatting()
      ):

    override def settersPackagePath: String      = basePackagePath + ".modifiers.KeySetter"
    override def scalaJsElementTypeParam: String = "Ref"
    override def scalaJsDomImport: String        = ""
    override def codecsImport: String            = "import scalive.codecs._"
    override def tagKeysPackagePath: String      = "scalive"
    override def keysPackagePath: String         = "scalive"

    override def generateTagsTrait(
      tagType: TagType,
      defGroups: List[(String, List[TagDef])],
      printDefGroupComments: Boolean,
      traitCommentLines: List[String],
      traitModifiers: List[String],
      traitName: String,
      keyKind: String,
      baseImplDefComments: List[String],
      keyImplName: String,
      defType: DefType
    ): String =
      val (rawDefs, defGroupComments) = defsAndGroupComments(defGroups, printDefGroupComments)
      val defs                         = rawDefs.map(scaliveTagComments)

      val baseImplDef =
        if tagType == HtmlTagType then
          List(
            s"def $keyImplName($keyImplNameArgName: String, void: Boolean = false): $keyKind = ${keyKindConstructor(keyKind)}($keyImplNameArgName, void)"
          )
        else
          List(
            s"def $keyImplName($keyImplNameArgName: String): $keyKind = ${keyKindConstructor(keyKind)}($keyImplNameArgName)"
          )

      val headerLines = List(
        s"package $tagDefsPackagePath",
        "",
        tagKeyTypeImport(keyKind),
        scalaJsDomImport,
        ""
      ) ++ standardTraitCommentLines.map("// " + _)

      new TagsTraitGenerator(
        defs = defs,
        defGroupComments = defGroupComments,
        headerLines = headerLines,
        traitCommentLines = traitCommentLines,
        traitModifiers = traitModifiers,
        traitName = traitName,
        traitExtends = Nil,
        traitThisType = None,
        defType = _ => defType,
        keyType = tag => keyKind,
        keyImplName = _ => keyImplName,
        keyImplNameArgName = keyImplNameArgName,
        baseImplDefComments = baseImplDefComments,
        baseImplDef = baseImplDef,
        outputImplDefs = true,
        format = format
      ):
        override protected def printDef(keyDef: TagDef, alias: Option[String]): Unit =
          alias match
            case Some(_) =>
              val canonicalName = keyDef.scalaName.stripPrefix("`").stripSuffix("`")
              blockCommentLines(
                List(s"Alias for the `$canonicalName` member defining the `<${keyDef.domName}>` HTML tag.")
              )
            case None if keyDef.commentLines.isEmpty && keyDef.docUrls.isEmpty =>
              blockCommentLines(List(s"Defines the `<${keyDef.domName}>` HTML tag."))
            case None => ()
          super.printDef(keyDef, alias)
      .printTrait().getOutput()
    end generateTagsTrait

    override def generateAttrsTrait(
      defGroups: List[(String, List[AttrDef])],
      printDefGroupComments: Boolean,
      traitCommentLines: List[String],
      traitModifiers: List[String],
      traitName: String,
      keyKind: String,
      implNameSuffix: String,
      baseImplDefComments: List[String],
      baseImplName: String,
      namespaceImports: List[String],
      namespaceImpl: String => String,
      transformAttrDomName: String => String,
      defType: DefType
    ): String =
      val (rawDefs, defGroupComments) = defsAndGroupComments(defGroups, printDefGroupComments)
      val defs                         = rawDefs.map(scaliveAttrComments)

      val tagTypes = defs.foldLeft(List[TagType]())((acc, k) => (acc :+ k.tagType).distinct)
      if tagTypes.size > 1 then
        throw new Exception(
          "Sorry, generateAttrsTrait does not support mixing attrs of different types in one call. You can contribute a PR (please contact us first), or bypass this limitation by calling AttrsTraitGenerator manually."
        )
      val tagType = tagTypes.head

      val baseImplDef =
        if tagType == SvgTagType then
          List(
            s"def $baseImplName[V]($keyImplNameArgName: String, encoder: Encoder[V, String], namespace: Option[String]): $keyKind[V] = ${keyKindConstructor(keyKind)}($keyImplNameArgName, encoder, namespace)"
          )
        else
          List(
            s"def $baseImplName[V]($keyImplNameArgName: String, encoder: Encoder[V, String]): $keyKind[V] = ${keyKindConstructor(keyKind)}($keyImplNameArgName, encoder)"
          )

      val headerLines = List(
        s"package $attrDefsPackagePath",
        "",
        keyTypeImport(keyKind),
        codecsImport
      ) ++ namespaceImports ++ List("") ++ standardTraitCommentLines.map("// " + _)

      new AttrsTraitGenerator(
        defs = defs.map(d => d.copy(domName = transformAttrDomName(d.domName))),
        defGroupComments = defGroupComments,
        headerLines = headerLines,
        traitCommentLines = traitCommentLines,
        traitModifiers = traitModifiers,
        traitName = traitName,
        traitExtends = Nil,
        traitThisType = None,
        defType = _ => defType,
        keyKind = keyKind,
        keyImplName = attr => attrImplName(attr.codec, implNameSuffix),
        keyImplNameArgName = keyImplNameArgName,
        baseImplDefComments = baseImplDefComments,
        baseImplName = baseImplName,
        baseImplDef = baseImplDef,
        transformCodecName = _ + "Encoder",
        namespaceImpl = namespaceImpl,
        outputImplDefs = true,
        format = format
      ):
        override protected def printDef(keyDef: AttrDef, alias: Option[String]): Unit =
          alias match
            case Some(_) =>
              val canonicalName = keyDef.scalaName.stripPrefix("`").stripSuffix("`")
              blockCommentLines(
                List(s"Alias for the `$canonicalName` member defining the `${keyDef.domName}` HTML attribute.")
              )
            case None if keyDef.commentLines.isEmpty && keyDef.docUrls.isEmpty =>
              blockCommentLines(List(s"Defines the `${keyDef.domName}` HTML attribute."))
            case None => ()
          super.printDef(keyDef, alias)
      .printTrait().getOutput()
    end generateAttrsTrait
  end generator

  def generate(): Unit =
    val defGroups = new CanonicalDefGroups()

    // -- HTML tags --

    {
      val traitName = "HtmlTags"

      val fileContent = generator.generateTagsTrait(
        tagType = HtmlTagType,
        defGroups = defGroups.htmlTagsDefGroups ++ defGroups.mathMlTagsDefGroups.map((name, defs) =>
          name -> defs.filter(_.scalaName == "mathTag")
        ),
        printDefGroupComments = true,
        traitCommentLines = List(
          "Reusable definitions for HTML tags.",
          "",
          "Each member is an [[HtmlTag]] factory that creates an element when applied to modifiers."
        ),
        traitModifiers = Nil,
        traitName = traitName,
        keyKind = "HtmlTag",
        baseImplDefComments = List(
          "Creates a reusable HTML tag definition.",
          "",
          "The name is validated by [[HtmlTag]]. Applying the returned tag creates an element.",
          "Set `void` only for tags that must be serialized without a closing tag; callers must still avoid supplying children.",
          "",
          "@param name",
          "  tag name, for example `div` or `mwc-input`",
          "@param void",
          "  whether elements created by this tag are serialized without a closing tag"
        ),
        keyImplName = "htmlTag",
        defType = LazyVal
      )

      generator.writeToFile(
        packagePath = generator.tagDefsPackagePath,
        fileName = traitName,
        fileContent = fileContent
      )
    }

    // -- HTML attributes --

    {
      val traitName = "HtmlAttrs"

      val fileContent = generator.generateAttrsTrait(
        defGroups = (defGroups.globalAttrDefGroups.map((name, defs) =>
          name -> defs.map(_.copy(tagType = HtmlTagType))
        ) ++ defGroups.htmlAttrDefGroups).appended(
          "Reflected Attributes" -> ReflectedHtmlAttrDefs.defs
            .map(d =>
              d.scalaName match
                case "defaultChecked"  => d.copy(scalaName = "checked")
                case "defaultSelected" => d.copy(scalaName = "selected")
                case "defaultValue"    => d.copy(scalaName = "value")
                case _                 => d
            ).map(_.toAttrDef)
        ),
        printDefGroupComments = false,
        traitCommentLines = List(
          "Typed definitions for HTML attributes.",
          "",
          "Assigning a value with `:=` encodes it using the definition's [[scalive.codecs.Encoder]]."
        ),
        traitModifiers = Nil,
        traitName = traitName,
        keyKind = "HtmlAttr",
        implNameSuffix = "HtmlAttr",
        baseImplDefComments = List(
          "Creates a typed HTML attribute definition.",
          "",
          "The name is validated by [[HtmlAttr]]. Values assigned with `:=` are encoded before rendering.",
          "",
          "@param name",
          "  attribute name, for example `value`",
          "@param encoder",
          "  encoder from `V` to the rendered attribute string",
          "@tparam V",
          "  Scala value type accepted by this attribute"
        ),
        baseImplName = "htmlAttr",
        namespaceImports = Nil,
        namespaceImpl = _ => ???,
        transformAttrDomName = identity,
        defType = LazyVal
      )

      generator.writeToFile(
        packagePath = generator.attrDefsPackagePath,
        fileName = traitName,
        fileContent = fileContent
      )
    }

    // -- Namespaced HTML attributes (composite keys) --

    {
      val traitName = "NamespacedHtmlKeys"

      val namespacedAttrs = List(
        "aria" -> List(
          NamespacedAttrDef("activedescendant", "activedescendant", "String"),
          NamespacedAttrDef("atomic", "atomic", "Boolean"),
          NamespacedAttrDef("autocomplete", "autocomplete", "String"),
          NamespacedAttrDef("busy", "busy", "Boolean"),
          NamespacedAttrDef("checked", "checked", "String"),
          NamespacedAttrDef("controls", "controls", "String"),
          NamespacedAttrDef("current", "current", "String"),
          NamespacedAttrDef("describedby", "describedby", "String"),
          NamespacedAttrDef("details", "details", "String"),
          NamespacedAttrDef("disabled", "disabled", "Boolean"),
          NamespacedAttrDef("errormessage", "errormessage", "String"),
          NamespacedAttrDef("expanded", "expanded", "Boolean"),
          NamespacedAttrDef("haspopup", "haspopup", "String"),
          NamespacedAttrDef("hidden", "hidden", "Boolean"),
          NamespacedAttrDef("invalid", "invalid", "String"),
          NamespacedAttrDef("keyshortcuts", "keyshortcuts", "String"),
          NamespacedAttrDef("label", "label", "String"),
          NamespacedAttrDef("labelledby", "labelledby", "String"),
          NamespacedAttrDef("level", "level", "Int"),
          NamespacedAttrDef("live", "live", "String"),
          NamespacedAttrDef("modal", "modal", "Boolean"),
          NamespacedAttrDef("multiline", "multiline", "Boolean"),
          NamespacedAttrDef("multiselectable", "multiselectable", "Boolean"),
          NamespacedAttrDef("orientation", "orientation", "String"),
          NamespacedAttrDef("owns", "owns", "String"),
          NamespacedAttrDef("placeholder", "placeholder", "String"),
          NamespacedAttrDef("pressed", "pressed", "String"),
          NamespacedAttrDef("readonly", "readonly", "Boolean"),
          NamespacedAttrDef("required", "required", "Boolean"),
          NamespacedAttrDef("roledescription", "roledescription", "String"),
          NamespacedAttrDef("selected", "selected", "Boolean"),
          NamespacedAttrDef("sort", "sort", "String"),
          NamespacedAttrDef("valuemax", "valuemax", "Double"),
          NamespacedAttrDef("valuemin", "valuemin", "Double"),
          NamespacedAttrDef("valuenow", "valuenow", "Double"),
          NamespacedAttrDef("valuetext", "valuetext", "String")
        ),
        "xlink" -> List(
          NamespacedAttrDef("href", "href", "String"),
          NamespacedAttrDef("title", "title", "String")
        )
      )

      val fileContent = generateNamespacedHtmlKeysTrait(traitName, namespacedAttrs)

      generator.writeToFile(
        packagePath = "scalive.defs.complex",
        fileName = traitName,
        fileContent = fileContent
      )
    }
  end generate
end DomDefsGenerator
