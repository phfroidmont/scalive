package build.documentation

import mill.*, scalalib.*

private def validateResourcePaths(roots: Seq[PathRef]): Unit =
  val files = roots.flatMap { root =>
    if os.exists(root.path) then
      os.walk(root.path)
        .filter(os.isFile)
        .map(path => path.relativeTo(root.path).toString -> root.path)
    else Seq.empty
  }
  val duplicates = files
    .groupMap(_._1)(_._2)
    .collect { case (path, owners) if owners.sizeIs > 1 => path -> owners }
    .toSeq
    .sortBy(_._1)

  if duplicates.nonEmpty then
    val details = duplicates
      .map { case (path, owners) => s"$path: ${owners.mkString(", ")}" }
      .mkString("\n")
    throw new IllegalArgumentException(s"Duplicate documentation resource paths:\n$details")

object `package` extends Module:
  object model extends build.ScalaCommon:
    def mvnDeps = Seq(mvn"dev.zio::zio-json:0.9.0")

    object test extends ScalaTests with TestModule.ZioTest:
      def zioTestVersion = "2.1.25"

  object pipeline extends build.ScalaCommon:
    def moduleDeps = Seq(model, build.scalive)
    def mvnDeps = Seq(
      mvn"org.typelevel::laika-io:1.3.2",
      mvn"ch.epfl.scala::tasty-query:1.8.0",
      mvn"org.scala-lang::scala3-tasty-inspector:3.8.3"
    )

    private def repositoryRoot = moduleDir / os.up / os.up

    private def allowedSourceRoots = Seq(
      os.sub / "scalive" / "src",
      os.sub / "scaliveTesting" / "src",
      os.sub / "documentation" / "site" / "src",
      os.sub / "examples" / "src"
    )

    def contentSources = Task.Sources(repositoryRoot / "documentation" / "content")

    def extractedSourceInputs =
      Task.Sources(allowedSourceRoots.map(repositoryRoot / _)*)

    def apiSettings = Task.Source(moduleDir / "api" / "reference.json")

    def apiSnapshot = Task.Source(moduleDir / "api" / "public-api.snapshot.json")

    def apiTargetRoots = Task {
      Seq(build.scalive.compile().classes, build.scaliveTesting.compile().classes)
    }

    def apiDependencyClasspath = Task {
      (build.scalive.compileClasspath() ++ build.scaliveTesting.compileClasspath()).distinct
    }

    def sourceRevision = Task.Input {
      sys.env.get("SCALIVE_DOCS_REVISION").getOrElse {
        os.proc("git", "rev-parse", "HEAD").call(cwd = repositoryRoot).out.text().trim
      }
    }

    def checkApi = Task {
      val classpath = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      val targets = apiTargetRoots().map(_.path).mkString(java.io.File.pathSeparator)
      val dependencies = apiDependencyClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      os.proc(
        "java",
        "-cp",
        classpath,
        "scalive.docs.pipeline.ApiReferenceTool",
        "check",
        repositoryRoot,
        sourceRevision(),
        apiSettings().path,
        apiSnapshot().path,
        targets,
        dependencies
      ).call(cwd = repositoryRoot)
    }

    def updateApiSnapshot = Task {
      val classpath = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      val targets = apiTargetRoots().map(_.path).mkString(java.io.File.pathSeparator)
      val dependencies = apiDependencyClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      os.proc(
        "java",
        "-cp",
        classpath,
        "scalive.docs.pipeline.ApiReferenceTool",
        "update",
        repositoryRoot,
        sourceRevision(),
        apiSettings().path,
        apiSnapshot().path,
        targets,
        dependencies
      ).call(cwd = repositoryRoot)
    }

    def apiReport = Task {
      val classpath = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      val targets = apiTargetRoots().map(_.path).mkString(java.io.File.pathSeparator)
      val dependencies = apiDependencyClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      val output = Task.dest / "api-reference.json"
      os.proc(
        "java",
        "-cp",
        classpath,
        "scalive.docs.pipeline.ApiReferenceTool",
        "report",
        repositoryRoot,
        sourceRevision(),
        apiSettings().path,
        apiSnapshot().path,
        targets,
        dependencies,
        output
      ).call(cwd = repositoryRoot)
      PathRef(output)
    }

    def generate = Task {
      contentSources()
      extractedSourceInputs()
      val settings = apiSettings()
      val snapshot = apiSnapshot()
      val targets = apiTargetRoots().map(_.path).mkString(java.io.File.pathSeparator)
      val dependencies = apiDependencyClasspath().map(_.path).mkString(java.io.File.pathSeparator)

      val classpath = runClasspath().map(_.path).mkString(java.io.File.pathSeparator)
      val arguments = Seq(
        "java",
        "-cp",
        classpath,
        "scalive.docs.pipeline.GenerateDocumentation",
        repositoryRoot.toString,
        (repositoryRoot / "documentation" / "content").toString,
        Task.dest.toString,
        sourceRevision(),
        settings.path.toString,
        snapshot.path.toString,
        targets,
        dependencies
      ) ++ allowedSourceRoots.map(_.toString)

      os.proc(arguments).call(cwd = repositoryRoot)
      PathRef(Task.dest)
    }

    object test extends ScalaTests with TestModule.ZioTest:
      override def moduleDeps = super.moduleDeps ++ Seq(build.scaliveTesting)
      def zioTestVersion = "2.1.25"

  object site extends build.ScalaCommon with build.NpmAssets:
    def moduleDeps = Seq(build.scalive, model)

    override def bundleOutputs = Seq(
      "app.js",
      "app.css",
      "fonts.css",
      "favicon.svg",
      "instrument-sans-OFL.txt",
      "jetbrains-mono-OFL.txt"
    )

    def resources = Task {
      val roots = super.resources() ++ Seq(pipeline.generate(), bundle())
      validateResourcePaths(roots)
      roots
    }

    def checkRuntimeClasspath = Task {
      val forbidden = runClasspath()
        .map(_.path.last)
        .filter(name =>
          name.contains("laika-") ||
            name.contains("tasty-query") ||
            name.contains("tasty-inspector")
        )

      if forbidden.nonEmpty then
        throw new IllegalArgumentException(
          s"Build-time dependencies found on the documentation site classpath: ${forbidden.mkString(", ")}"
        )
    }

    def searchRankingFixture = Task.Source(
      moduleDir / os.up / "model" / "test" / "resources" / "search-ranking.json"
    )

    def testJs = Task {
      assetSources()
      searchRankingFixture()
      npmInstall()
      os.proc("npm", "test").call(cwd = moduleDir)
    }

    object test extends ScalaTests with TestModule.ZioTest:
      override def moduleDeps = super.moduleDeps ++ Seq(build.scaliveTesting)
      def zioTestVersion = "2.1.25"

  def check = Task {
    model.test.testCached()
    pipeline.test.testCached()
    pipeline.checkApi()
    pipeline.generate()
    site.test.testCached()
    site.testJs()
    site.checkRuntimeClasspath()
  }
